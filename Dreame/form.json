{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Dreame-Konto (dreamehome)",
      "items": [
        { "type": "Label", "caption": "Zugangsdaten deiner dreamehome-App. Der X50 ist nur über die Dreame-Cloud steuerbar (kein lokaler Direktzugriff)." },
        { "type": "ValidationTextBox", "name": "Email", "caption": "E-Mail / Benutzer" },
        { "type": "PasswordTextBox", "name": "Password", "caption": "Passwort" },
        {
          "type": "Select",
          "name": "Region",
          "caption": "Region / Server",
          "options": [
            { "caption": "Europa (eu)", "value": "eu" },
            { "caption": "China (cn)", "value": "cn" },
            { "caption": "USA (us)", "value": "us" },
            { "caption": "Singapur (sg)", "value": "sg" },
            { "caption": "Korea (kr)", "value": "kr" }
          ]
        },
        { "type": "NumberSpinner", "name": "UpdateInterval", "caption": "Status-Abfrage alle (Sek.)", "minimum": 10, "maximum": 3600 },
        { "type": "NumberSpinner", "name": "FastAfterChange", "caption": "Schnell-Poll nach Aktion (Sek.)", "minimum": 5, "maximum": 120 },
        { "type": "Button", "caption": "Login testen", "onClick": "DREAME_TestLogin($id);" }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Karten & Räume",
      "items": [
        { "type": "Label", "caption": "Liest Etagen und Räume aus der Karte ein. Nach Umbau/Neukartierung erneut einlesen." },
        { "type": "Button", "caption": "Karten & Räume einlesen", "onClick": "DREAME_DiscoverMapsAndRooms($id);" },
        { "type": "Label", "caption": "Nur die mit „Verwenden“ angehakten Räume erscheinen im Dropdown „Raum reinigen“ und erhalten einen Auswahl-Schalter. Dreame legt beim Kartieren gelegentlich Räume an, die es nicht gibt (Blick durch Fenster oder Glastüren) – diese hier abwählen und „Änderungen übernehmen“ drücken." },
        {
          "type": "List",
          "name": "RoomFilter",
          "caption": "Räume",
          "rowCount": 12,
          "add": false,
          "delete": false,
          "loadValuesFromConfiguration": false,
          "columns": [
            { "caption": "Verwenden", "name": "use", "width": "100px", "edit": { "type": "CheckBox" } },
            { "caption": "Etage", "name": "floor", "width": "120px", "save": true },
            { "caption": "Karte", "name": "mapid", "width": "60px", "save": true },
            { "caption": "Segment-ID", "name": "seg", "width": "90px", "save": true },
            { "caption": "Raum", "name": "name", "width": "auto", "save": true }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Steuerung / Test",
      "items": [
        {
          "type": "RowLayout",
          "items": [
            { "type": "Button", "caption": "Alles reinigen", "onClick": "DREAME_CleanAll($id);" },
            { "type": "Button", "caption": "Pause", "onClick": "DREAME_Pause($id);" },
            { "type": "Button", "caption": "Stopp", "onClick": "DREAME_Stop($id);" },
            { "type": "Button", "caption": "Zur Basis", "onClick": "DREAME_Charge($id);" },
            { "type": "Button", "caption": "Orten (Piepen)", "onClick": "DREAME_Locate($id);" }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            { "type": "Button", "caption": "Ausgewählte Räume reinigen", "onClick": "DREAME_CleanSelectedRooms($id);" },
            { "type": "Button", "caption": "Auswahl leeren", "onClick": "DREAME_ClearRoomSelection($id);" }
          ]
        },
        { "type": "Button", "caption": "Status jetzt abfragen", "onClick": "DREAME_UpdateStatus($id);" }
      ]
    }
  ],
  "actions": [
    { "type": "Label", "caption": "Statusvariablen: Zustand, Akku, Fehler, Reinigungszeit/-fläche. Steuerung über die Variablen „Aktion“ und „Raum reinigen“." },
    { "type": "Label", "caption": "Mehrere Räume: die gewünschten Schalter „Auswahl <Raum>“ einschalten und in „Aktion“ den Punkt „Ausgewählte Räume reinigen“ wählen. Nach dem Durchgang wird die Auswahl automatisch geleert. Per Skript: DREAME_CleanRooms($id, <Karten-ID>, '5,6,7')." },
    { "type": "Label", "caption": "Vorwahlen vor dem Start: Reinigungsmodus (nur kehren / nur wischen / zusammen / erst kehren dann wischen), Reinigungsroute (Standard / Intensiv / Tiefen / Schnell), Saugkraft, Wischfeuchte und Durchgänge. Jede Vorwahl auf „Geräteeinstellung belassen“ ändert am Gerät nichts." },
    { "type": "Label", "caption": "Achtung: Ist am Gerät „Individuelle Raumeinstellungen“ aktiv (Diagnosevariable), benutzt der Roboter die je Raum in der App gespeicherten Werte und ignoriert Saugkraft, Wischfeuchte und Durchgänge aus diesem Modul." }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Aktiv" },
    { "code": 104, "icon": "inactive", "caption": "Inaktiv" },
    { "code": 201, "icon": "error", "caption": "E-Mail/Passwort nicht konfiguriert" }
  ]
}
